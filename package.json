{
  "name": "homestays",
  "private": true,
  "version": "1.0.0",
  "description": "HomeStays - homestay booking & property management platform (Vercel-ready demo mode)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch server/dev.js",
    "dev:web": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "npm run build && node server/dev.js --static",
    "serve": "node server/dev.js --static",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.13.0",
    "@supabase/supabase-js": "^2.117.2",
    "bcryptjs": "^3.0.3",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-redux": "^9.3.0",
    "react-router-dom": "^7.18.4",
    "redux-saga": "^1.5.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "concurrently": "^10.0.5",
    "jsdom": "^30.1.1",
    "postcss": "^8.5.28",
    "supertest": "^7.3.0",
    "tailwindcss": "^3.4.19",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
