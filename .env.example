# All variables are OPTIONAL. With none set, HomeStays runs in demo mode.

# Secret used to sign JWTs. A public demo secret is used when unset (fine for demos, NOT for production).
JWT_SECRET=

# Set BOTH to switch the API from demo storage to Supabase PostgreSQL (server-side only, never exposed to the browser).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Local API port for `npm run dev` / `npm run serve`
PORT=3001
